<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MarkeratorFast.Views.WelcomePageView">
    <Border Margin="15">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5">
                Welcome to Markerator.
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5">
                A simple and intuitive website generator.
            </TextBlock>
            
            <Button HorizontalAlignment="Center" Padding="5" Margin="5" CornerRadius="5">Start from scratch</Button>
            <Button HorizontalAlignment="Center" Padding="5" Margin="5" CornerRadius="5">Open an existing project</Button>
        </StackPanel>
    </Border>
</UserControl>