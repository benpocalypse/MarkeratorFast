<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        x:Class="MarkeratorFast.Views.MainView"
        xmlns:vm="using:MarkeratorFast.ViewModels"
        xmlns:viewModels="clr-namespace:MarkeratorFast.ViewModels"
        Title="Markerator Fast!"
        WindowDecorations="None"
        Name="Window"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        MinWidth="400"
        MinHeight="600"
        Width="1024"
        Height="768"
        Icon="/Assets/Icon.png"
        x:DataType="viewModels:MainViewModel">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>
    
    <dialogHost:DialogHost CloseOnClickAway="True" Name="diagHost" Identifier="MainDialogHost" dialogHost:DialogHostStyle.CornerRadius="8">
        <dialogHost:DialogHost.DialogContent>
            <vm:AboutDialogViewModel />
        </dialogHost:DialogHost.DialogContent>
        
        <Border CornerRadius="15" Background="{DynamicResource FlyoutBackground}" BorderThickness="1" 
                Padding="5"
                Margin="5"
                BoxShadow="5 5 5 0 #80000000">
            
            <Grid Name="WindowChrome"
                  Background="{DynamicResource FlyoutBackground}"
                  DockPanel.Dock="Top"
                  ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                  RowDefinitions="Auto,Auto,*,Auto,Auto">
                
                <Border Name="TopLeft" BorderThickness="5" Background="{DynamicResource FlyoutBackground}" Grid.Row="0" Grid.Column="0"/>
                <Border Name="TopRight" BorderThickness="5" Background="{DynamicResource FlyoutBackground}" Grid.Row="0" Grid.Column="4"/>
                <Border Name="BottomLeft" BorderThickness="5" Background="{DynamicResource FlyoutBackground}" Grid.Row="4" Grid.Column="0" />
                <Border Name="BottomRight" BorderThickness="5" Background="{DynamicResource FlyoutBackground}"  Grid.Row="4" Grid.Column="4"/>
                <Border Name="Top" BorderThickness="5" Background="{DynamicResource FlyoutBackground}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"/>
                <Border Name="Right" BorderThickness="5" Background="{DynamicResource FlyoutBackground}" Grid.Row="1"  Grid.Column="4" Grid.RowSpan="3"/>
                <Border Name="Bottom" BorderThickness="5" Background="{DynamicResource FlyoutBackground}" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"/>
                <Border Name="Left" BorderThickness="5" Background="{DynamicResource FlyoutBackground}"  Grid.Row="1" Grid.Column="0" Grid.RowSpan="3"/>
                
                <StackPanel Grid.Column="1"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="{DynamicResource FlyoutBackground}">
                    
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="CornerRadius" Value="20"/>
                            <Setter Property="Height" Value="28"/>
                        </Style>
                    </StackPanel.Styles>
                    
                    <Button Name="CloseButton" HorizontalAlignment="Left"
                            Margin="0 0 5 0"
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource HeaderBarText}">✖</Button>
                    <Button Name="MinimizeButton" HorizontalAlignment="Left"
                            Margin="5 0 5 0"
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource HeaderBarText}">🗕</Button>
                    <Button Name="MaximizeButton" HorizontalAlignment="Left"
                            Margin="5 0 5 0"
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource HeaderBarText}">🗖</Button>
                    <Button Name="SwitchPaneButton" HorizontalAlignment="Left"
                            Margin="5 0 5 0"
                            IsVisible="{Binding !IsOpenPanel}"
                            IsEnabled="{Binding !IsOpenPanel}"
                            Background="{DynamicResource FlyoutBackground}"
                            Foreground="{DynamicResource HeaderBarText}">
                        <PathIcon Data="{DynamicResource CollapseIcon}"/>
                    </Button>
                </StackPanel>
                
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,5,0"
                               HorizontalAlignment="Center"
                               Background="{DynamicResource FlyoutBackground}"
                               Foreground="{DynamicResource HeaderBarText}"
                               Text="Markerator Fast!" />
                        
                    <Menu HorizontalAlignment="Right" Margin="00 3 1 1">
                        <MenuItem>
                            <MenuItem.Header>
                                <PathIcon Data="{DynamicResource HamburgerIcon}" />
                            </MenuItem.Header>
                            <MenuItem Header="Get Latest Markerator" IsEnabled="False"/>
                            <MenuItem Header="Preferences" IsEnabled="False"/>
                            <MenuItem Header="About" Name="AboutButton"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                
                <SplitView Grid.Column="1"
                           Grid.Row="2"
                           Grid.ColumnSpan="3"
                           Grid.RowSpan="2"
                           Name="MainSplitView"
                           IsPaneOpen="{Binding IsOpenPanel}"
                           OpenPaneLength="135"
                           CompactPaneLength="36"
                           DisplayMode="CompactInline">
                    
                    <SplitView.Pane>
                        <Border Background="{DynamicResource FlyoutBackground}" >
                            <StackPanel Orientation="Vertical">
                                
                                <Button 
                                    Name="WelcomeButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="3"
                                    Padding="5"
                                    CornerRadius="5">
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <PathIcon Data="{DynamicResource HomeIcon}" />
                                        <TextBlock Margin="3" >Welcome</TextBlock>
                                    </StackPanel>
                                </Button>
                                
                                <Button 
                                    Name="SiteDetailsButton"
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource FlyoutBackground}"
                                    Margin="3"
                                    Padding="5"
                                    CornerRadius="5">
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <PathIcon Data="{DynamicResource WizardIcon}" />
                                        <TextBlock Margin="3" >Site Details</TextBlock>
                                    </StackPanel>
                                </Button>
                                
                                <Button 
                                    Name="PreviewButton"
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource FlyoutBackground}"
                                    Margin="3"
                                    Padding="5"
                                    CornerRadius="5">
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <PathIcon Data="{DynamicResource WebBrowser}" />
                                        <TextBlock Margin="3" >Preview Site</TextBlock>
                                    </StackPanel>
                                </Button>
                                
                            </StackPanel>
                        </Border>
                    </SplitView.Pane>
                    
                    <SplitView.Content>
                        <Border CornerRadius="12 0 0 0"
                                Background="{DynamicResource FlyoutBackground}"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch">
                            <TransitioningContentControl
                                Margin="2"
                                CornerRadius="5"
                                Content="{Binding CurrentPage}"
                                Background="{DynamicResource ContentBackground}"/>
                        </Border>
                        
                    </SplitView.Content>
                </SplitView>
            </Grid>
        </Border>
    </dialogHost:DialogHost>
</Window>
